# ~/.config/zathura/zathurarc

# ── Ajuste de página ──────────────────────────────
set adjust-open "best-fit"
set pages-per-row 1
set scroll-page-aware true

# ── UI ───────────────────────────────────────────
set guioptions sb
set window-title-home-tilde true
set window-title-page true
set statusbar-h-padding 8
set statusbar-v-padding 4

# ── Clipboard ────────────────────────────────────
set selection-clipboard clipboard

# ── Recolor (colores desde Noctalia) ────────────────────────
set recolor true
set recolor-keephue true
# Los colores los define el tema de Noctalia (include al final del archivo).
# Valores previos de gruvbox por si se quiere volver atrás:
# set recolor-lightcolor "#282828"
# set recolor-darkcolor "#ebdbb2"

# ── Zoom ─────────────────────────────────────────
set zoom-min 10
set zoom-step 5

# ── Navegación ───────────────────────────────────
set scroll-step 25
set scroll-hstep 25 
map h scroll left
map l scroll right
map J navigate next
map K navigate previous

# ── Vista ────────────────────────────────────────
map i recolor
map F toggle_fullscreen
map [fullscreen] F toggle_fullscreen
map = zoom in
map - zoom out
map 0 zoom default

# ── Índice/TOC (muy útil en libros técnicos) ──────
map <Tab> toggle_index

# ── Tema Noctalia (community template zathura) ────────────────────
# Noctalia regenera ~/.config/zathura/noctaliarc en cada cambio de paleta y su
# apply.sh manda `ExecuteCommand string:"source"` por D-Bus a las instancias
# abiertas, que releen este archivo (y con él el include) en caliente.
# Va AL FINAL: en zathura gana la última opción leída, así el tema sobreescribe
# los colores de arriba. Si deshabilitás la plantilla, quitá esta línea.
include noctaliarc

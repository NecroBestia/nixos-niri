# ── Modo oscuro ───────────────────────────────────────────────────
default_dark_mode 1
dark_mode_contrast 0.8
vertical_move_amount 0.3
horizontal_move_amount 0.3
move_screen_ratio 0.3
startup_commands    toggle_dark_mode
should_launch_new_window 1
# Ventanas separadas por proceso (deprecated upstream, pero should_launch_new_window
# es ignorado por esta build 2.0.0-2026-04-08 en el path IPC; esto se decide en el
# emisor que lee disco en cada lanzamiento). Si upstream lo elimina, usar
# `sioyek --new-window` / Ctrl+T + `o`.
should_launch_new_instance 1
# ── Colores ───────────────────────────────────────────────────────

# Los aporta el tema de Noctalia (ver `source` al final). Los custom_* solo
# se usan en el modo que activa `toggle_custom_color`, y ahora los define el
# tema. Valores previos por si se quiere volver atrás:
# custom_background_color 0.157 0.157 0.157
# custom_text_color 0.922 0.733 0.698

# ── Tema Noctalia (community template «sioyek») ───────────────────
# Noctalia regenera ~/.config/sioyek/themes/noctalia.config en cada cambio de
# paleta (background, highlights, status bar y colores de UI del wallpaper).
#
# `source` va AL FINAL: en Sioyek cada asignación posterior sobrescribe la
# anterior, así que el tema gana sobre cualquier color declarado arriba.
#
# La línea DEBE estar acá: el apply.sh de la plantilla hace
#   grep -Eq '^source[[:space:]]+.*sioyek/themes/noctalia\.config$' "$prefs" \
#     || printf '\nsource %s\n' "$file" >> "$prefs"
# y prefs_user.config es un symlink read-only al nix store (home.file en
# shared/default.nix): el append fallaba con "Permission denied" y el tema
# nunca se cargaba. Al existir ya la línea, el grep evita el append.
#source ~/.config/sioyek/themes/noctalia.config

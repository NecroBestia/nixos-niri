# =============================================================================
# FIREFOX — anti-rastreo y anti-fingerprint
# =============================================================================
# Revisión y evidencia: ~/Projects/opencodePlans/revision-firefox-hardening/revision.md
#
# Tres capas, de más fuerte a más débil:
#
#   1. extraPrefs -> autoconfig (lib/firefox/mozilla.cfg del paquete).
#      lockPref() REAL: gana sobre prefs.js y sobre about:config. Al ir en el
#      paquete, aplica a cualquier perfil. Aquí va todo lo que la policy
#      "Preferences" NO puede fijar (su allowlist no admite privacy.* salvo
#      fingerprintingProtection / globalprivacycontrol.enabled / userContext.*).
#
#   2. policies   -> distribution/policies.json (también en el paquete, locked).
#
#   3. profiles   -> user.js del perfil (se reaplica cada arranque, pero el
#      usuario puede cambiarlo en caliente). Contenedores, handlers de Zoom,
#      prefs cosméticas.
#
# CAMBIO CLAVE respecto de la versión anterior:
#   * `preConfig` ELIMINADO. HM escribe preConfig dentro de user.js y el parser
#     de prefs de Firefox (modules/libpref/parser/src/lib.rs) sólo acepta
#     `user_pref` en ficheros de usuario: lockPref() ahí NO bloquea nada.
#   * `configPath` + `profiles.default.path`: antes HM escribía el perfil en
#     ~/.config/mozilla/firefox/ y Firefox usaba ~/.mozilla/firefox/<perfil>
#     (si existe la raíz clásica, gana esa). Resultado: nada de este módulo
#     llegaba al Firefox real.
# =============================================================================
{ pkgs-unstable, ... }:
let
  # ---------------------------------------------------------------------------
  # CAPA 1 — autoconfig: nixpkgs escribe esto en lib/firefox/mozilla.cfg
  # ---------------------------------------------------------------------------
  prefLocks = ''
    // ===== Fingerprinting: elige UNA opción (revision.md §3) =====
    // Opción A (ACTIVA): FPP, lo que Mozilla activa con ETP estricto.
    // Rompe poco y usa las protecciones nuevas: canvas aleatorio por eTLD+1 y
    // sesión, fuentes del sistema, spoof de hardwareConcurrency/maxTouchPoints,
    // offset de pantalla y ruido en WebGL readPixels (FF143-145).
    lockPref("privacy.fingerprintingProtection", true);
    lockPref("privacy.resistFingerprinting", false); // neutraliza el true que quedó a mano en prefs.js

    // Opción B: RFP (uniformidad tipo Tor). Descomenta estas 3 y COMENTA las 2
    // de la opción A. Coste: hora UTC, UA/navigator spoofeados, canvas en
    // blanco, prefers-color-scheme en claro, bandas grises de letterboxing.
    // Bajo RFP, FPP se ignora (arkenfox §4000/7016), así que no lo fijes.
    // lockPref("privacy.resistFingerprinting", true);
    // lockPref("privacy.resistFingerprinting.letterboxing", true);
    // lockPref("privacy.resistFingerprinting.block_mozAddonManager", true);

    // ===== Rastreo =====
    lockPref("browser.contentblocking.category", "strict");
    lockPref("privacy.trackingprotection.enabled", true);
    lockPref("privacy.trackingprotection.emailtracking.enabled", true);
    lockPref("privacy.trackingprotection.socialtracking.enabled", true);
    lockPref("privacy.trackingprotection.cryptomining.enabled", true);
    lockPref("privacy.trackingprotection.fingerprinting.enabled", true);
    lockPref("privacy.query_stripping.enabled", true);
    lockPref("privacy.query_stripping.enabled.pbmode", true);
    lockPref("privacy.bounceTrackingProtection.mode", 1); // borra cookies de bouncers
    lockPref("privacy.globalprivacycontrol.enabled", true); // GPC sustituye al DNT
    lockPref("network.cookie.cookieBehavior", 5); // Total Cookie Protection (dFPI)
    lockPref("network.cookie.cookieBehavior.pbmode", 5);
    lockPref("network.http.referer.XOriginTrimmingPolicy", 2); // cross-site: sólo el origen
    lockPref("network.http.referer.disallowCrossSiteRelaxingDefault", true);
    lockPref("network.http.referer.disallowCrossSiteRelaxingDefault.top_navigation", true);
    // Opcional agresivo (rompe logins embebidos); probar antes de dejarlo:
    // lockPref("network.http.referer.XOriginPolicy", 2); // 2 = sólo si coincide el host

    // ===== Higiene al cerrar =====
    // cookiesAndStorage=true te desloguea de todo al cerrar Firefox.
    // Con Bitwarden + contenedores es asumible; si molesta, ponlo en false.
    lockPref("privacy.sanitize.sanitizeOnShutdown", true);
    lockPref("privacy.clearOnShutdown_v2.cache", true);
    lockPref("privacy.clearOnShutdown_v2.formdata", true);
    lockPref("privacy.clearOnShutdown_v2.cookiesAndStorage", true);
    lockPref("privacy.clearOnShutdown_v2.historyFormDataAndDownloads", false);
    lockPref("privacy.clearOnShutdown_v2.browsingHistoryAndDownloads", false);

    // ===== Red: fugas de WebRTC y prefetch =====
    // Firefox ya ofusca los candidatos ICE con mDNS; lo que falta es no exponer
    // interfaces ni IP privada. NO uses media.peerconnection.ice.no_host ni
    // media.navigator.enabled=false si haces videollamadas en el navegador.
    lockPref("media.peerconnection.ice.default_address_only", true);
    lockPref("media.peerconnection.ice.proxy_only_if_behind_proxy", true);
    lockPref("network.dns.disablePrefetch", true);
    lockPref("network.dns.disablePrefetchFromHTTPS", true);
    lockPref("network.prefetch-next", false);
    lockPref("network.predictor.enable-prefetch", false);
    lockPref("browser.urlbar.speculativeConnect.enabled", false);
    lockPref("browser.places.speculativeConnect.enabled", false);
    lockPref("browser.search.suggest.enabled", false); // no mandes al buscador lo que tecleas
    lockPref("browser.urlbar.suggest.searches", false);

    // ===== APIs y superficies menores =====
    lockPref("webgl.enable-debug-renderer-info", false); // no expongas GPU/renderer
    lockPref("dom.battery.enabled", false);
    lockPref("beacon.enabled", false);

    // ===== Lo que la versión anterior tenía y YA NO va =====
    // privacy.firstparty.isolate=true    -> desactiva TCP y el particionado de red (arkenfox 6008)
    // network.cookie.lifetimePolicy=0    -> el pref ya no existe en FF156
    // privacy.donottrackheader.enabled   -> el header DNT ya no se envía; el GPC lo sustituye
    // webgl.disabled=false               -> era el valor por defecto
    // media.peerconnection.enabled=true  -> era el valor por defecto (y el comentario decía "hardening")
    // dom.event.clipboardevents=false    -> detectable por el sitio y rompe pegar (arkenfox 7013)
    // geo.enabled=false                  -> la API es detectable; se bloquea el permiso (policy Permissions)
  '';
in {
  programs.firefox = {
    enable = true;

    # nixpkgs añade prefLocks a lib/firefox/mozilla.cfg (autoconfig).
    # Home Manager después re-aplica sus `policies` sobre este mismo paquete.
    package = pkgs-unstable.firefox.override { extraPrefs = prefLocks; };

    # -------------------------------------------------------------------------
    # CAPA 2 — políticas (bloqueadas, a nivel paquete)
    # -------------------------------------------------------------------------
    policies = {
      # --- Bloque original (funciona; se mantiene tal cual) ---
      DisableTelemetry = true;
      DisableFirefoxStudies = true;
      DisablePocket = true;
      DisableFormHistory = true;
      OfferToSaveLogins = false; # Bitwarden cubre esto
      PasswordManagerEnabled = false;
      HttpsOnlyMode = "enabled";
      DNSOverHTTPS = {
        Enabled = true;
        ProviderURL = "https://cloudflare-dns.com/dns-query";
        Locked = true;
        Fallback = false; # ojo con portales cautivos (revision.md §7)
      };

      # --- Anti-rastreo ---
      EnableTrackingProtection = {
        Value = true;
        Locked = true;
        # FF142+: fija todo el set estricto. BaselineExceptions/ConvenienceExceptions
        # los documenta Mozilla pero NO están en el esquema de FF156
        # (policies-schema.json): se omiten. Baseline queda en su default (true) y
        # convenience respeta la elección previa del perfil (false).
        Category = "strict";
      };
      Cookies = {
        Behavior = "reject-tracker-and-partition-foreign"; # Total Cookie Protection
        Locked = true;
      };
      NetworkPrediction = false; # DNS prefetch / precarga
      SearchSuggestEnabled = false;
      Permissions = {
        Location = {
          BlockNewRequests = true;
          Locked = true;
        };
        Notifications = {
          BlockNewRequests = true;
          Locked = true;
        };
      };

      # --- Ruido y telemetría de la UI ---
      FirefoxHome = {
        SponsoredTopSites = false;
        Stories = false; # reemplaza a Pocket desde FF141
        SponsoredStories = false; # reemplaza a SponsoredPocket
        Locked = true;
      };
      FirefoxSuggest = {
        WebSuggestions = false; # FF146+: apaga Suggest por completo
        SponsoredSuggestions = false;
        ImproveSuggest = false;
        Locked = true;
      };
      UserMessaging = {
        ExtensionRecommendations = false;
        FeatureRecommendations = false;
        UrlbarInterventions = false;
        SkipOnboarding = true;
        MoreFromMozilla = false;
        FirefoxLabs = false;
        Locked = true;
      };
      DisableFeedbackCommands = true;
      DisableProfileImport = true;
      DontCheckDefaultBrowser = true;
      OverrideFirstRunPage = "";
      OverridePostUpdatePage = "";
    };

    # -------------------------------------------------------------------------
    # CAPA 3 — perfil real (el que Firefox abre de verdad)
    # -------------------------------------------------------------------------
    # HM por defecto escribe en ~/.config/mozilla/firefox; Firefox prefiere
    # ~/.mozilla/firefox cuando existe ahí profiles.ini. Estas dos líneas
    # alinean HM con el perfil que ya usas (no se pierde nada).
    configPath = ".mozilla/firefox";

    profiles.default = {
      id = 0;
      isDefault = true;
      path = "4xm81sjl.default"; # perfil vivo; backup de profiles.ini antes de aplicar
      # Firefox reescribe containers.json en cada arranque (rompe el symlink);
      # sin esto hm-switch aborta con "would be clobbered".
      containersForce = true;

      # -----------------------------------------------------------------------
      # Prefs no críticas (user.js: se reaplican en cada arranque)
      # -----------------------------------------------------------------------
      settings = {
        # --- Coherencia con los lockPref del autoconfig ---
        # Neutraliza el privacy.resistFingerprinting=true que quedó a mano en
        # prefs.js (si algún día pasas a la opción B, ponlo en true).
        "privacy.resistFingerprinting" = false;

        # --- Wayland y portapapeles ---
        "widget.use-xdg-desktop-portal" = 1;
        "middlemouse.paste" = false;
        "browser.tabs.warnOnClose" = false;

        # --- Protocol handlers de Zoom ---
        "network.protocol-handler.external.zoommtg" = true;
        "network.protocol-handler.warn-external.zoommtg" = false;
        "network.protocol-handler.external.zoomus" = true;
        "network.protocol-handler.warn-external.zoomus" = false;
        "network.protocol-handler.external.tel" = true;
        "network.protocol-handler.warn-external.tel" = false;
        "network.protocol-handler.external.callto" = true;
        "network.protocol-handler.warn-external.callto" = false;
        "network.protocol-handler.external.zoomphonecall" = true;
        "network.protocol-handler.warn-external.zoomphonecall" = false;
        "network.protocol-handler.external.zoomphonesms" = true;
        "network.protocol-handler.warn-external.zoomphonesms" = false;
        "network.protocol-handler.external.zoomcontactcentercall" = true;
        "network.protocol-handler.warn-external.zoomcontactcentercall" = false;
      };

      # -----------------------------------------------------------------------
      # CONTENEDORES (declarativos: containers.json pasa a ser symlink de sólo
      # lectura del store -> Firefox ya no podrá editarlos desde la UI)
      # -----------------------------------------------------------------------
      # IDs alineados con los contenedores que Firefox creó por defecto para no
      # remapear las cookies ya guardadas (1 personal, 2 work, 3 banking,
      # 4 shopping). Social ocupa el 5, que queda libre.
      containers = {
        "Personal" = {
          id = 1;
          color = "blue";
          icon = "fingerprint";
        };
        "Trabajo" = {
          id = 2;
          color = "orange";
          icon = "briefcase";
        };
        "Banca" = {
          id = 3;
          color = "green";
          icon = "dollar";
        };
        "Compras" = {
          id = 4;
          color = "yellow";
          icon = "cart";
        };
        "Social" = {
          id = 5;
          color = "pink";
          icon = "circle";
        };
      };
    };
  };

  # =========================================================================
  # ENTORNO WAYLAND
  # =========================================================================
  # Redundante en FF156 (Wayland ya es el default en sesión Wayland), se deja
  # por si se lanza Firefox fuera de la sesión gráfica.
  home.sessionVariables.MOZ_ENABLE_WAYLAND = "1";
}
